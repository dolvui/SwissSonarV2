# .streamlit/secrets.toml
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the real secrets.toml to git.

[reddit]
client_id     = "YOUR_REDDIT_CLIENT_ID"
client_secret = "YOUR_REDDIT_CLIENT_SECRET"
user_agent    = "crypto-dashboard/1.0 by u/YOUR_REDDIT_USERNAME"

[youtube]
api_key = "YOUR_GOOGLE_YOUTUBE_API_KEY"

# Note: Google Trends (pytrends) does NOT require a key — it uses the public web endpoint.
